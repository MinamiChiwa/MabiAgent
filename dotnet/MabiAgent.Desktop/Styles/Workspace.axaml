<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="https://irihi.tech/ursa">
<Styles.Resources><ResourceDictionary>
<!-- Noto Sans SC (SIL OFL 1.1) is embedded; its GB 18030 coverage includes every Big5 traditional character. -->
<FontFamily x:Key="WorkspaceFont">avares://MabiAgent.Desktop/Assets/Fonts#Noto Sans SC, Microsoft YaHei UI, Microsoft JhengHei UI, Segoe UI</FontFamily>
<FontFamily x:Key="DefaultFontFamily">avares://MabiAgent.Desktop/Assets/Fonts#Noto Sans SC, Microsoft YaHei UI, Microsoft JhengHei UI, Segoe UI</FontFamily>
<ResourceDictionary.ThemeDictionaries>
<ResourceDictionary x:Key="Dark">
<!-- Dusk: painted sky over hills; panels are dark glass so the scene shows through at the edges -->
<SolidColorBrush x:Key="WorkspacePage" Color="#101820"/><SolidColorBrush x:Key="WorkspaceSidebar" Color="#E6141C26"/><SolidColorBrush x:Key="WorkspaceSurface" Color="#E81A2130"/><SolidColorBrush x:Key="WorkspaceInput" Color="#121826"/><SolidColorBrush x:Key="WorkspaceBorder" Color="#1FFFFFFF"/><SolidColorBrush x:Key="WorkspaceMuted" Color="#B7C0CE"/><SolidColorBrush x:Key="WorkspaceDanger" Color="#FF8A7A"/>
<SolidColorBrush x:Key="WorkspaceSuccess" Color="#6DE0A8"/><SolidColorBrush x:Key="WorkspaceSuccessText" Color="#FFFFFF"/><SolidColorBrush x:Key="WorkspaceSelectedText" Color="#FFFFFF"/><SolidColorBrush x:Key="WorkspaceWarning" Color="#FFD24A"/><SolidColorBrush x:Key="WorkspaceInfo" Color="#FFFFFF"/>
<SolidColorBrush x:Key="WorkspaceSuccessSoft" Color="#1A3A2E"/><SolidColorBrush x:Key="WorkspaceWarningSoft" Color="#3B3218"/><SolidColorBrush x:Key="WorkspaceInfoSoft" Color="#173B3E"/><SolidColorBrush x:Key="WorkspaceNeutralSoft" Color="#26303F"/>
<SolidColorBrush x:Key="WorkspaceOverlay" Color="#B3060A0E"/>
<SolidColorBrush x:Key="WorkspaceTabSelected" Color="#FFFFFF"/><SolidColorBrush x:Key="WorkspaceTabSelectedText" Color="#161A24"/><SolidColorBrush x:Key="WorkspaceTabText" Color="#E8EEF6"/>
<SolidColorBrush x:Key="WorkspaceRuntimeSurface" Color="#E81A2232"/><SolidColorBrush x:Key="WorkspaceRuntimeAccent" Color="#7FF0D2"/>
<SolidColorBrush x:Key="WorkspaceQueueSurface" Color="#E81A2130"/><SolidColorBrush x:Key="WorkspaceQueueAccent" Color="#7FF0D2"/>
<SolidColorBrush x:Key="WorkspaceCatalogSurface" Color="#E819222A"/><SolidColorBrush x:Key="WorkspaceCatalogAccent" Color="#7FD3BE"/>
<SolidColorBrush x:Key="WorkspaceAccountsSurface" Color="#E81D1F31"/><SolidColorBrush x:Key="WorkspaceAccountsAccent" Color="#C6B3F5"/>
<SolidColorBrush x:Key="WorkspaceSettingsSurface" Color="#E81F2129"/><SolidColorBrush x:Key="WorkspaceSettingsAccent" Color="#FFD24A"/>
<SolidColorBrush x:Key="WorkspaceWorkflowSurface" Color="#E81C2033"/><SolidColorBrush x:Key="WorkspaceWorkflowAccent" Color="#B4B7FA"/>
<SolidColorBrush x:Key="WorkspaceAnchorSurface" Color="#E818232C"/><SolidColorBrush x:Key="WorkspaceAnchorAccent" Color="#86D3DC"/>
<SolidColorBrush x:Key="WorkspaceLibrarySurface" Color="#E81F1E2E"/><SolidColorBrush x:Key="WorkspaceLibraryAccent" Color="#DDB1DA"/>
<LinearGradientBrush x:Key="WorkspaceSceneSky" StartPoint="50%,0%" EndPoint="50%,100%"><GradientStop Color="#1B3A4E" Offset="0"/><GradientStop Color="#2E5A5E" Offset="0.45"/><GradientStop Color="#29473A" Offset="0.62"/><GradientStop Color="#0F1E19" Offset="1"/></LinearGradientBrush>
<RadialGradientBrush x:Key="WorkspaceSceneSun" Center="85%,22%" GradientOrigin="85%,22%" RadiusX="45%" RadiusY="40%"><GradientStop Color="#66F2B880" Offset="0"/><GradientStop Color="#00F2B880" Offset="1"/></RadialGradientBrush>
<RadialGradientBrush x:Key="WorkspaceSceneHillA" Center="20%,82%" GradientOrigin="20%,82%" RadiusX="40%" RadiusY="22%"><GradientStop Color="#8A3E7A48" Offset="0"/><GradientStop Color="#003E7A48" Offset="1"/></RadialGradientBrush>
<RadialGradientBrush x:Key="WorkspaceSceneHillB" Center="72%,92%" GradientOrigin="72%,92%" RadiusX="50%" RadiusY="24%"><GradientStop Color="#8A2F6436" Offset="0"/><GradientStop Color="#002F6436" Offset="1"/></RadialGradientBrush>
<RadialGradientBrush x:Key="WorkspaceSceneShade" Center="45%,40%" GradientOrigin="45%,40%" RadiusX="80%" RadiusY="80%"><GradientStop Color="#33060A0E" Offset="0.4"/><GradientStop Color="#B3060A0E" Offset="1"/></RadialGradientBrush>
<SolidColorBrush x:Key="SemiColorPrimary" Color="#2FD6E8"/><SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#5BEBEA"/><SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#17B98A"/><SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#2B4E56"/>
<SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#173B3E"/><SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#1E4A4E"/><SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#25585D"/>
<SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground" Color="#17B98A"/><SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="#2BD3A0"/><SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="#12A07A"/>
<SolidColorBrush x:Key="SelectionListIndicatorBackground" Color="#2FD6E8"/>
<SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#FFFFFF"/>
<SolidColorBrush x:Key="ButtonDefaultBackground" Color="#1FFFFFFF"/><SolidColorBrush x:Key="ButtonDefaultPointeroverBackground" Color="#2EFFFFFF"/><SolidColorBrush x:Key="ButtonDefaultPressedBackground" Color="#40FFFFFF"/>
<LinearGradientBrush x:Key="ButtonSolidPrimaryBackground" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#17B98A" Offset="0"/><GradientStop Color="#2FD6E8" Offset="0.7"/><GradientStop Color="#5BEBEA" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="ButtonSolidPrimaryPointeroverBackground" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#2BD3A0" Offset="0"/><GradientStop Color="#5BEBEA" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="ButtonSolidPrimaryPressedBackground" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#12A07A" Offset="0"/><GradientStop Color="#22B8C8" Offset="1"/></LinearGradientBrush>
<SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="Transparent"/><SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="Transparent"/><SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="Transparent"/>
<SolidColorBrush x:Key="ButtonSolidForeground" Color="#0E2A2A"/><SolidColorBrush x:Key="ButtonSolidPrimaryPressedForeground" Color="#0E2A2A"/>
<SolidColorBrush x:Key="ProgressBarPrimaryForeground" Color="#2FD6E8"/><SolidColorBrush x:Key="SemiColorFocusBorder" Color="#2FD6E8"/><SolidColorBrush x:Key="SemiColorLink" Color="#FFFFFF"/><SolidColorBrush x:Key="SemiColorLinkPointerover" Color="#FFFFFF"/><SolidColorBrush x:Key="SemiColorLinkActive" Color="#FFFFFF"/>
</ResourceDictionary>
<ResourceDictionary x:Key="Light">
<!-- Daylight: brighter sky and hills; panels are light frosted glass -->
<SolidColorBrush x:Key="WorkspacePage" Color="#DCE8EC"/><SolidColorBrush x:Key="WorkspaceSidebar" Color="#E6F7FAFC"/><SolidColorBrush x:Key="WorkspaceSurface" Color="#F2FFFFFF"/><SolidColorBrush x:Key="WorkspaceInput" Color="#EEF2F6"/><SolidColorBrush x:Key="WorkspaceBorder" Color="#1F0F1B33"/><SolidColorBrush x:Key="WorkspaceMuted" Color="#4E5A6B"/><SolidColorBrush x:Key="WorkspaceDanger" Color="#B42318"/>
<SolidColorBrush x:Key="WorkspaceSuccess" Color="#12704A"/><SolidColorBrush x:Key="WorkspaceSuccessText" Color="#12704A"/><SolidColorBrush x:Key="WorkspaceSelectedText" Color="#0B6E78"/><SolidColorBrush x:Key="WorkspaceWarning" Color="#8A5208"/><SolidColorBrush x:Key="WorkspaceInfo" Color="#0B6E78"/>
<SolidColorBrush x:Key="WorkspaceSuccessSoft" Color="#E3F5EC"/><SolidColorBrush x:Key="WorkspaceWarningSoft" Color="#FBF0DC"/><SolidColorBrush x:Key="WorkspaceInfoSoft" Color="#DDF4F4"/><SolidColorBrush x:Key="WorkspaceNeutralSoft" Color="#E9EEF3"/>
<SolidColorBrush x:Key="WorkspaceOverlay" Color="#59141626"/>
<SolidColorBrush x:Key="WorkspaceTabSelected" Color="#161A24"/><SolidColorBrush x:Key="WorkspaceTabSelectedText" Color="#FFFFFF"/><SolidColorBrush x:Key="WorkspaceTabText" Color="#26303F"/>
<SolidColorBrush x:Key="WorkspaceRuntimeSurface" Color="#F2FDFEFF"/><SolidColorBrush x:Key="WorkspaceRuntimeAccent" Color="#0B6E78"/>
<SolidColorBrush x:Key="WorkspaceQueueSurface" Color="#F2FCFDFF"/><SolidColorBrush x:Key="WorkspaceQueueAccent" Color="#0B6E78"/>
<SolidColorBrush x:Key="WorkspaceCatalogSurface" Color="#F2FBFEFD"/><SolidColorBrush x:Key="WorkspaceCatalogAccent" Color="#21705A"/>
<SolidColorBrush x:Key="WorkspaceAccountsSurface" Color="#F2FDFBFF"/><SolidColorBrush x:Key="WorkspaceAccountsAccent" Color="#7350A6"/>
<SolidColorBrush x:Key="WorkspaceSettingsSurface" Color="#F2FEFDFA"/><SolidColorBrush x:Key="WorkspaceSettingsAccent" Color="#8C6228"/>
<SolidColorBrush x:Key="WorkspaceWorkflowSurface" Color="#F2FBFBFF"/><SolidColorBrush x:Key="WorkspaceWorkflowAccent" Color="#5B55B5"/>
<SolidColorBrush x:Key="WorkspaceAnchorSurface" Color="#F2FAFEFE"/><SolidColorBrush x:Key="WorkspaceAnchorAccent" Color="#1F6E7E"/>
<SolidColorBrush x:Key="WorkspaceLibrarySurface" Color="#F2FFFBFE"/><SolidColorBrush x:Key="WorkspaceLibraryAccent" Color="#8F5286"/>
<LinearGradientBrush x:Key="WorkspaceSceneSky" StartPoint="50%,0%" EndPoint="50%,100%"><GradientStop Color="#8FC3D3" Offset="0"/><GradientStop Color="#C6DFD2" Offset="0.46"/><GradientStop Color="#8DB67E" Offset="0.62"/><GradientStop Color="#4F7A52" Offset="1"/></LinearGradientBrush>
<RadialGradientBrush x:Key="WorkspaceSceneSun" Center="85%,24%" GradientOrigin="85%,24%" RadiusX="45%" RadiusY="40%"><GradientStop Color="#99FFE6B8" Offset="0"/><GradientStop Color="#00FFE6B8" Offset="1"/></RadialGradientBrush>
<RadialGradientBrush x:Key="WorkspaceSceneHillA" Center="20%,82%" GradientOrigin="20%,82%" RadiusX="40%" RadiusY="22%"><GradientStop Color="#995E9F5A" Offset="0"/><GradientStop Color="#005E9F5A" Offset="1"/></RadialGradientBrush>
<RadialGradientBrush x:Key="WorkspaceSceneHillB" Center="72%,92%" GradientOrigin="72%,92%" RadiusX="50%" RadiusY="24%"><GradientStop Color="#994E8F4A" Offset="0"/><GradientStop Color="#004E8F4A" Offset="1"/></RadialGradientBrush>
<RadialGradientBrush x:Key="WorkspaceSceneShade" Center="45%,40%" GradientOrigin="45%,40%" RadiusX="80%" RadiusY="80%"><GradientStop Color="#00FFFFFF" Offset="0.5"/><GradientStop Color="#40203040" Offset="1"/></RadialGradientBrush>
<SolidColorBrush x:Key="SemiColorPrimary" Color="#0B7F8A"/><SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#096C76"/><SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#075A62"/><SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#9FD8DE"/>
<SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#DDF4F4"/><SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#CDEEEF"/><SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#BCE6E8"/>
<SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground" Color="#17B98A"/><SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="#12A07A"/><SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="#0E8A68"/>
<SolidColorBrush x:Key="SelectionListIndicatorBackground" Color="#0B7F8A"/>
<SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#0B6E78"/>
<SolidColorBrush x:Key="ButtonDefaultBackground" Color="#14102030"/><SolidColorBrush x:Key="ButtonDefaultPointeroverBackground" Color="#24102030"/><SolidColorBrush x:Key="ButtonDefaultPressedBackground" Color="#33102030"/>
<LinearGradientBrush x:Key="ButtonSolidPrimaryBackground" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#17B98A" Offset="0"/><GradientStop Color="#2FD6E8" Offset="0.7"/><GradientStop Color="#5BEBEA" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="ButtonSolidPrimaryPointeroverBackground" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#2BD3A0" Offset="0"/><GradientStop Color="#5BEBEA" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="ButtonSolidPrimaryPressedBackground" StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#12A07A" Offset="0"/><GradientStop Color="#22B8C8" Offset="1"/></LinearGradientBrush>
<SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="Transparent"/><SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="Transparent"/><SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="Transparent"/>
<SolidColorBrush x:Key="ButtonSolidForeground" Color="#0E2A2A"/><SolidColorBrush x:Key="ButtonSolidPrimaryPressedForeground" Color="#0E2A2A"/>
<SolidColorBrush x:Key="ProgressBarPrimaryForeground" Color="#17B98A"/><SolidColorBrush x:Key="SemiColorFocusBorder" Color="#0B7F8A"/><SolidColorBrush x:Key="SemiColorLink" Color="#0B6E78"/><SolidColorBrush x:Key="SemiColorLinkPointerover" Color="#096C76"/><SolidColorBrush x:Key="SemiColorLinkActive" Color="#075A62"/>
</ResourceDictionary>
</ResourceDictionary.ThemeDictionaries></ResourceDictionary></Styles.Resources>

  <!-- Base typography and window -->
  <Style Selector=":is(Window)"><Setter Property="FontFamily" Value="{StaticResource WorkspaceFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{DynamicResource WorkspacePage}"/></Style>
  <Style Selector=":is(u|UrsaWindow)"><Setter Property="ExtendClientAreaToDecorationsHint" Value="False"/><Setter Property="IsTitleBarVisible" Value="False"/></Style>
  <Style Selector=":is(Control)"><Setter Property="UseLayoutRounding" Value="True"/></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/></Style>
  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource WorkspaceDanger}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.field"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/></Style>
  <Style Selector="TextBlock.setting-title"><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="TextBlock.status-info"><Setter Property="Foreground" Value="{DynamicResource WorkspaceInfo}"/></Style>
  <Style Selector="TextBlock.status-success"><Setter Property="Foreground" Value="{DynamicResource WorkspaceSuccessText}"/></Style>
  <Style Selector="TextBlock.status-warning"><Setter Property="Foreground" Value="{DynamicResource WorkspaceWarning}"/></Style>
  <Style Selector="TextBlock.status-error"><Setter Property="Foreground" Value="{DynamicResource WorkspaceDanger}"/></Style>
  <Style Selector="StackPanel[Orientation=Horizontal] > TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <!-- Surfaces: neutral bordered cards; module colors only tint the background -->
  <Style Selector="Border.card"><Setter Property="Theme" Value="{StaticResource CardBorder}"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="20"/><Setter Property="BoxShadow" Value="0 10 30 0 #2E000000"/><Setter Property="Background" Value="{DynamicResource WorkspaceSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/></Style>
  <Style Selector="Border.card.flush"><Setter Property="Padding" Value="0"/><Setter Property="ClipToBounds" Value="True"/></Style>
  <Style Selector="Border.card.inset"><Setter Property="Background" Value="{DynamicResource WorkspaceInput}"/><Setter Property="BoxShadow" Value="none"/><Setter Property="CornerRadius" Value="14"/></Style>
  <Style Selector="Border.card.section-runtime"><Setter Property="Background" Value="{DynamicResource WorkspaceRuntimeSurface}"/></Style>
  <Style Selector="Border.card.section-queue"><Setter Property="Background" Value="{DynamicResource WorkspaceQueueSurface}"/></Style>
  <Style Selector="Border.card.section-catalog"><Setter Property="Background" Value="{DynamicResource WorkspaceCatalogSurface}"/></Style>
  <Style Selector="Border.card.section-accounts"><Setter Property="Background" Value="{DynamicResource WorkspaceAccountsSurface}"/></Style>
  <Style Selector="Border.card.section-settings"><Setter Property="Background" Value="{DynamicResource WorkspaceSettingsSurface}"/></Style>
  <Style Selector="Border.card.section-workflow"><Setter Property="Background" Value="{DynamicResource WorkspaceWorkflowSurface}"/></Style>
  <Style Selector="Border.card.section-anchor"><Setter Property="Background" Value="{DynamicResource WorkspaceAnchorSurface}"/></Style>
  <Style Selector="Border.card.section-library"><Setter Property="Background" Value="{DynamicResource WorkspaceLibrarySurface}"/></Style>
  <Style Selector="Border.sidebar"><Setter Property="Background" Value="{DynamicResource WorkspaceSidebar}"/><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}"/></Style>
  <Style Selector="Border.icon-tile"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="CornerRadius" Value="10"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}"/></Style>
  <Style Selector="Border.icon-tile > PathIcon"><Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.brand-mark"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="{DynamicResource ButtonSolidPrimaryBackground}"/></Style>
  <Style Selector="Border.brand-mark > PathIcon"><Setter Property="Foreground" Value="{DynamicResource ButtonSolidForeground}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.selection-bar"><Setter Property="Background" Value="{DynamicResource WorkspaceInfoSoft}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style Selector="Border.card DataGrid"><Setter Property="BorderThickness" Value="0"/></Style>

  <!-- Status pills -->
  <Style Selector="Border.pill, Border.state"><Setter Property="Padding" Value="10,3"/><Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="24"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{DynamicResource WorkspaceNeutralSoft}"/></Style>
  <Style Selector="Border.pill TextBlock, Border.state TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.pill Ellipse.dot"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Fill" Value="{DynamicResource WorkspaceMuted}"/></Style>
  <Style Selector="Border.pill.success"><Setter Property="Background" Value="{DynamicResource WorkspaceSuccessSoft}"/></Style>
  <Style Selector="Border.pill.success Ellipse.dot"><Setter Property="Fill" Value="{DynamicResource WorkspaceSuccess}"/></Style>
  <Style Selector="Border.pill.success TextBlock"><Setter Property="Foreground" Value="{DynamicResource WorkspaceSuccessText}"/></Style>
  <Style Selector="Border.pill.warning"><Setter Property="Background" Value="{DynamicResource WorkspaceWarningSoft}"/></Style>
  <Style Selector="Border.pill.warning Ellipse.dot"><Setter Property="Fill" Value="{DynamicResource WorkspaceWarning}"/></Style>
  <Style Selector="Border.pill.warning TextBlock"><Setter Property="Foreground" Value="{DynamicResource WorkspaceWarning}"/></Style>

  <!-- Controls -->
  <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="16,6"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="SplitButton"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="18"/></Style>
  <Style Selector="Button.help"><Setter Property="CornerRadius" Value="16"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="MinWidth" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/></Style>
  <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource WorkspaceDanger}"/></Style>
  <Style Selector="Button.side"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,6"/></Style>
  <Style Selector="Button.side:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WorkspaceNeutralSoft}"/></Style>
  <Style Selector="WrapPanel > Button"><Setter Property="Margin" Value="0,4,8,4"/></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{DynamicResource WorkspaceInput}"/></Style>
  <Style Selector="TextBox:multiline"><Setter Property="VerticalContentAlignment" Value="Top"/></Style>
  <Style Selector="TextBox TextBlock.suffix"><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/></Style>
  <Style Selector="TextBox PathIcon.prefix"><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{DynamicResource WorkspaceInput}"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
  <Style Selector="TextBox:not(:multiline), ComboBox, CheckBox, ToggleSwitch"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="CheckBox, ToggleSwitch"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="NumericUpDown"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="CheckBox, NumericUpDown, ToggleSwitch"><Setter Property="MinHeight" Value="36"/></Style>
  <Style Selector="TextBox:focus-within, ComboBox:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}"/></Style>
  <Style Selector="Button#PART_MinimizeButton, Button#PART_MaximizeButton, Button#PART_CloseButton, Button#PART_FullScreenButton, Button#PART_PopoverFullScreenButton, Button#PART_PopoverCloseButton"><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="VerticalAlignment" Value="Stretch"/></Style>
  <Style Selector="DataGrid"><Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="RowHeight" Value="42"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="DataGridCell"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style Selector="DataGridColumnHeader"><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/></Style>
  <Style Selector="DataGridRow.drag-source, ListBoxItem.drag-source"><Setter Property="Opacity" Value="0.35"/></Style>
  <Style Selector="DataGridCell.editable"><Setter Property="Background" Value="{DynamicResource WorkspaceInfoSoft}"/><Setter Property="Cursor" Value="Ibeam"/></Style>
  <Style Selector="DataGridCell.editable:current"><Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="360"/><Setter Property="Padding" Value="12,10"/></Style>
  <Style Selector="ToolTip TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>

  <!-- Painted scene behind the glass panels (original gradients, no game art) -->
  <Style Selector="Border.scene-sky"><Setter Property="Background" Value="{DynamicResource WorkspaceSceneSky}"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style Selector="Border.scene-sun"><Setter Property="Background" Value="{DynamicResource WorkspaceSceneSun}"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style Selector="Border.scene-hill-a"><Setter Property="Background" Value="{DynamicResource WorkspaceSceneHillA}"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style Selector="Border.scene-hill-b"><Setter Property="Background" Value="{DynamicResource WorkspaceSceneHillB}"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style Selector="Border.scene-shade"><Setter Property="Background" Value="{DynamicResource WorkspaceSceneShade}"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style Selector="Border.glass-bar"><Setter Property="Background" Value="{DynamicResource WorkspaceSidebar}"/><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="28"/><Setter Property="BoxShadow" Value="0 12 36 0 #40000000"/></Style>
  <Style Selector="Button.chrome-link"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="12"/></Style>

  <!-- Navigation: floating bottom tab bar; selected tab is a solid capsule -->
  <Style Selector="ListBox.tabs"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="ListBox.tabs > ListBoxItem"><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="2,0"/><Setter Property="CornerRadius" Value="20"/><Setter Property="MinHeight" Value="52"/><Setter Property="MinWidth" Value="76"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceTabText}"/></Style>
  <Style Selector="ListBox.tabs > ListBoxItem:selected"><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="ListBox.tabs > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WorkspaceTabSelected}"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceTabSelectedText}"/></Style>
  <Style Selector="ListBox.tabs > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WorkspaceNeutralSoft}"/></Style>
  <Style Selector="ListBox.tabs > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WorkspaceTabSelected}"/></Style>
  <Style Selector="ListBox.tabs TextBlock"><Setter Property="FontSize" Value="12"/></Style>

  <!-- Summary tiles (chain/anchor pages): compact text cells that wrap to the panel width -->
  <Style Selector="ListBox.summary"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="ListBox.summary > ListBoxItem"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="{DynamicResource WorkspaceInput}"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style Selector="ListBox.summary > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WorkspaceNeutralSoft}"/></Style>
  <Style Selector="ListBox.summary > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}"/></Style>

  <!-- Legacy vertical navigation (workbench sidebar) -->
  <Style Selector="ListBox.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBox.nav > ListBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style Selector="ListBox.nav > ListBoxItem.group-start"><Setter Property="Margin" Value="0,18,0,2"/></Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected"><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceSelectedText}"/></Style>
  <Style Selector="ListBox.nav > ListBoxItem PathIcon.trailing"><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="Opacity" Value="0.55"/></Style>

  <!-- Setting rows -->
  <Style Selector="Grid.setting-row"><Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="0,4"/></Style>
  <Style Selector="Grid.setting-row > StackPanel"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Spacing" Value="2"/><Setter Property="Margin" Value="0,0,16,0"/></Style>
  <Style Selector="Grid.card-header"><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style Selector="u|Divider"><Setter Property="Margin" Value="0,4"/></Style>
  <Style Selector="Border.segmented"><Setter Property="Background" Value="{DynamicResource WorkspaceInput}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="4"/></Style>
  <Style Selector="Border.segmented u|SelectionListItem"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style>

  <!-- Compact window: one card, 28px icon buttons, thin progress bars -->
  <Style Selector="Border.mini-shell"><Setter Property="Background" Value="{DynamicResource WorkspaceSceneSky}"/><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="ClipToBounds" Value="True"/></Style>
  <Style Selector="Ellipse.status-dot"><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Fill" Value="{DynamicResource WorkspaceMuted}"/></Style>
  <Style Selector="Ellipse.status-dot.success"><Setter Property="Fill" Value="{DynamicResource WorkspaceSuccess}"/></Style>
  <Style Selector="Ellipse.status-dot.warning"><Setter Property="Fill" Value="{DynamicResource WorkspaceWarning}"/></Style>
  <Style Selector="Button.mini-icon, ToggleButton.mini-icon"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Button.mini-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.mini-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WorkspaceNeutralSoft}"/></Style>
  <Style Selector="ToggleButton.mini-icon:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}"/><Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}"/></Style>
  <Style Selector="Button.mini-icon.warning"><Setter Property="Foreground" Value="{DynamicResource WorkspaceWarning}"/></Style>
  <Style Selector="Button.mini-round"><Setter Property="Width" Value="36"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="Button.mini-expand"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Margin" Value="10,0,10,8"/><Setter Property="Background" Value="{DynamicResource WorkspaceSidebar}"/><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Border.mini-job"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource WorkspaceInput}"/></Style>
  <Style Selector="Border.mini-job.active"><Setter Property="Background" Value="{DynamicResource WorkspaceInfoSoft}"/></Style>
  <Style Selector="Border.mini-panel"><Setter Property="Background" Value="{DynamicResource WorkspaceRuntimeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Margin" Value="8,0,8,8"/></Style>
  <Style Selector="ProgressBar.mini-progress"><Setter Property="MinHeight" Value="6"/><Setter Property="Height" Value="6"/><Setter Property="MinWidth" Value="0"/><Setter Property="CornerRadius" Value="3"/></Style>
  <Style Selector="ProgressBar.mini-progress.thin"><Setter Property="MinHeight" Value="4"/><Setter Property="Height" Value="4"/><Setter Property="CornerRadius" Value="2"/></Style>

  <Style Selector="Button.toolbar-icon"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="0"/></Style>
  <!-- Motion: short transitions on interactive surfaces; content fades without moving layout -->
  <Style Selector="Button"><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.14"/><BrushTransition Property="Foreground" Duration="0:0:0.14"/><BrushTransition Property="BorderBrush" Duration="0:0:0.14"/><DoubleTransition Property="Opacity" Duration="0:0:0.10"/></Transitions></Setter></Style>
  <Style Selector="TextBox"><Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.14"/><BrushTransition Property="Background" Duration="0:0:0.14"/></Transitions></Setter></Style>
  <Style Selector="ComboBox"><Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.14"/><BrushTransition Property="Background" Duration="0:0:0.14"/></Transitions></Setter></Style>
  <Style Selector="Border.card"><Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.16"/><BrushTransition Property="Background" Duration="0:0:0.16"/></Transitions></Setter></Style>
  <Style Selector="Border.pill"><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.20"/></Transitions></Setter></Style>
  <Style Selector="ListBoxItem"><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.14"/><BrushTransition Property="BorderBrush" Duration="0:0:0.14"/><DoubleTransition Property="Opacity" Duration="0:0:0.10"/></Transitions></Setter></Style>
  <Style Selector="CheckBox"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.10"/></Transitions></Setter></Style>
  <Style Selector="DataGridRow"><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.10"/><DoubleTransition Property="Opacity" Duration="0:0:0.10"/></Transitions></Setter></Style>
  <!-- Page fades and the dialog entrance run on the compositor (Controls/Motion.cs), never on logical Opacity. -->
  <Style Selector="Border.overlay"><Setter Property="Background" Value="{DynamicResource WorkspaceOverlay}"/></Style>
  <Style Selector="Border.card.drawer"><Setter Property="Background" Value="{DynamicResource WorkspaceSurface}"/><Setter Property="BoxShadow" Value="-12 0 36 0 #33000000"/></Style>
  <Style Selector="Border.card.dialog"><Setter Property="Padding" Value="24"/><Setter Property="BoxShadow" Value="0 16 40 0 #40000000"/><Setter Property="Background" Value="{DynamicResource WorkspaceSurface}"/></Style>
</Styles>
